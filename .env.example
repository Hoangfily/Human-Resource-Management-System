POSTGRES_DB=hr_agent
POSTGRES_USER=hr_agent
POSTGRES_PASSWORD=change-me-local
DATABASE_URL=postgresql://hr_agent:change-me-local@postgres:5432/hr_agent?schema=public
REDIS_URL=redis://redis:6379/0
API_PORT=3000
AI_PORT=8000
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:3000
AI_API_BASE_URL=http://ai:8000

# Shared secrets between api and ai (giong nhau giua 2 service)
AI_SERVICE_TOKEN=ai-service-secret-token-hr-2026
AI_INBOUND_TOKEN=ai-inbound-secret-token-hr-2026

# LLM cho ai service: openai | gemini | fake. De trong = theo LLM_MODEL, khong co thi provider co key (ca hai: openai).
# Nhap key that khi chay AI.
LLM_PROVIDER=
OPENAI_API_KEY=
GEMINI_API_KEY=
# De trong = model mac dinh cua provider (apps/ai/app/config.py DEFAULT_MODELS)
LLM_MODEL=
LLM_FALLBACK_MODELS=
# Giay cho moi lan goi model
LLM_TIMEOUT_S=

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
