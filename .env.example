POSTGRES_DB=hr_agent
POSTGRES_USER=hr_agent
POSTGRES_PASSWORD=change-me-local
DATABASE_URL=postgresql://hr_agent:change-me-local@postgres:5432/hr_agent?schema=public
REDIS_URL=redis://redis:6379/0
API_PORT=3000
AI_PORT=8000
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:3000
AI_API_BASE_URL=http://ai:8000
# Shared secrets between api and ai (set the same value in both services)
AI_SERVICE_TOKEN=replace-with-a-long-random-token-for-ai-to-api
AI_INBOUND_TOKEN=replace-with-a-long-random-token-for-api-to-ai
# Gemini key for the ai service; never commit the real value
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODELS=gemini-3.5-flash
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
