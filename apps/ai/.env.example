PORT=8000
API_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO

# Same values as apps/api/.env. Local only: use new random values for any shared or real deployment.
# AI -> API (Authorization: Bearer ...)
AI_SERVICE_TOKEN=ai-service-secret-token-hr-2026
# API -> AI (/evaluate, header X-Service-Token)
AI_INBOUND_TOKEN=ai-inbound-secret-token-hr-2026

# openai | gemini | fake. Empty = from LLM_MODEL, else the provider whose key is set (openai if both)
LLM_PROVIDER=
# Empty = the provider's defaults (app/config.py DEFAULT_MODELS)
LLM_MODEL=
LLM_FALLBACK_MODELS=
# Seconds per model attempt
LLM_TIMEOUT_S=20
# Put the real keys in apps/ai/.env (git-ignored), never here
OPENAI_API_KEY=
GEMINI_API_KEY=

AI_MIN_CONFIDENCE=0.85
AI_MAX_AUTO_LEAVE_DAYS=3
COMPANY_TIMEZONE=Asia/Ho_Chi_Minh
