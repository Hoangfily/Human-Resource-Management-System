PORT=8000
API_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO

# AI -> API (Authorization: Bearer ...)
AI_SERVICE_TOKEN=dev-ai-service-token
# API -> AI (/evaluate, header X-Service-Token)
AI_INBOUND_TOKEN=dev-ai-inbound-token

# gemini | fake
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODELS=gemini-3.5-flash
# Seconds per model attempt
LLM_TIMEOUT_S=20
# Put the real key in apps/ai/.env (git-ignored), never here
GEMINI_API_KEY=

AI_MIN_CONFIDENCE=0.85
AI_MAX_AUTO_LEAVE_DAYS=3
COMPANY_TIMEZONE=Asia/Ho_Chi_Minh
