generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Employee {
  id        String   @id @default(uuid())
  email     String   @unique
  fullName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Request {
  id        String        @id @default(uuid())
  type      String
  status    RequestStatus @default(DRAFT)
  payload   Json
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}