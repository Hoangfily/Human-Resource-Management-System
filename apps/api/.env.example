PORT=3000
DATABASE_URL=postgresql://hr_agent:change-me-local@localhost:5432/hr_agent?schema=public
REDIS_URL=redis://localhost:6379/0
# Bat buoc: thieu thi API khong khoi dong. Gia tri mau chi dung o may local, deploy that phai doi sang chuoi ngau nhien dai
JWT_ACCESS_SECRET=hr_agent_super_secret_jwt_access_token_key_2026
JWT_REFRESH_SECRET=hr_agent_super_secret_jwt_refresh_token_key_2026

# Ket noi AI Service (giong apps/ai/.env; deploy that phai doi token)
AI_API_BASE_URL=http://localhost:8000
AI_SERVICE_TOKEN=ai-service-secret-token-hr-2026
AI_INBOUND_TOKEN=ai-inbound-secret-token-hr-2026
