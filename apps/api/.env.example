PORT=3000
DATABASE_URL=postgresql://hr_agent:change-me-local@localhost:5432/hr_agent?schema=public
REDIS_URL=redis://localhost:6379/0
# Bat buoc: thieu thi API khong khoi dong. Gia tri mau chi dung o may local, deploy that phai doi sang chuoi ngau nhien dai
JWT_ACCESS_SECRET=hr_agent_super_secret_jwt_access_token_key_2026
JWT_REFRESH_SECRET=hr_agent_super_secret_jwt_refresh_token_key_2026

# Ket noi AI Service (giong apps/ai/.env; deploy that phai doi token)
AI_API_BASE_URL=http://localhost:8000
AI_SERVICE_TOKEN=ai-service-secret-token-hr-2026
AI_INBOUND_TOKEN=ai-inbound-secret-token-hr-2026

# Chi cho seed/admin script (khong dung khi chay API). Production: dat SEED_PASSWORD hoac khong seed tai khoan mau
# SEED_PASSWORD=Demo@12345
# ADMIN_PASSWORD=

# Gioi han so lan goi (moi phut, theo IP). De trong = mac dinh. AI Service (service token) khong bi gioi han
# THROTTLE_LOGIN_PER_MIN=5
# THROTTLE_CHAT_PER_MIN=20
# THROTTLE_GLOBAL_PER_MIN=120

# CORS: cac origin cua web, cach nhau dau phay. De trong: may phat trien cho phep http://localhost:5173,
# production (NODE_ENV=production) khong mo CORS vi web va API cung origin qua proxy
# CORS_ORIGINS=http://localhost:5173

# So proxy tin cay dung truoc API (Caddy = 1). Chi dat khi API KHONG lo thang ra Internet,
# neu khong nguoi goi gia X-Forwarded-For de ne gioi han so lan goi
# TRUST_PROXY=1
