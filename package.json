{
  "name": "hr-agent-monorepo",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev:web": "npm --workspace @hr-agent/web run dev",
    "build:web": "npm --workspace @hr-agent/web run build",
    "dev:api": "npm --workspace @hr-agent/api run start:dev",
    "build:api": "npm --workspace @hr-agent/api run build"
  }
}
