{
  "name": "hr-agent-monorepo",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "build": "npm run build:api && npm run build:web",
    "dev": "concurrently -n \"API,WEB\" -c \"cyan,magenta\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm --workspace @hr-agent/web run dev",
    "build:web": "npm --workspace @hr-agent/web run build",
    "dev:api": "npm --workspace @hr-agent/api run start:dev",
    "build:api": "npm --workspace @hr-agent/api run build",
    "seed:api": "npm --workspace @hr-agent/api run seed",
    "admin:create": "npm --workspace @hr-agent/api run admin:create --",
    "secrets:generate": "node scripts/gen-secrets.mjs",
    "prod:up": "docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build",
    "prod:down": "docker compose -f docker-compose.prod.yml --env-file .env.production down",
    "prod:logs": "docker compose -f docker-compose.prod.yml --env-file .env.production logs -f --tail=100",
    "prod:seed": "docker compose -f docker-compose.prod.yml --env-file .env.production exec api node --experimental-strip-types prisma/seed.ts",
    "prod:admin": "docker compose -f docker-compose.prod.yml --env-file .env.production exec api node --experimental-strip-types prisma/admin-user.ts",
    "prod:backup": "node scripts/backup-db.mjs",
    "prisma:generate": "prisma generate --schema=apps/api/prisma/schema.prisma",
    "db:migrate": "npm --workspace @hr-agent/api run db:migrate",
    "db:migrate:dev": "npm --workspace @hr-agent/api run db:migrate:dev --",
    "db:baseline": "npm --workspace @hr-agent/api run db:baseline",
    "db:push": "npm --workspace @hr-agent/api run db:push"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
