# Mẫu cho docker-compose.prod.yml. Sao chép thành .env.production (đã nằm trong .gitignore, KHÔNG commit):
#   cp .env.production.example .env.production
# rồi điền các dòng trống. Dòng nào còn trống thì `docker compose` dừng và báo tên biến thiếu.
#
# Năm dòng đầu: chạy `npm run secrets:generate` để có giá trị ngẫu nhiên (64 ký tự), dán vào đây.
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
AI_SERVICE_TOKEN=
AI_INBOUND_TOKEN=

# Key OpenAI (lấy ở trang quản lý của OpenAI; đừng dùng lại key đã từng dán vào chat hay commit)
OPENAI_API_KEY=

# Để trống: chạy HTTP cổng 80, truy cập bằng IP hoặc http://localhost. Có tên miền: ví dụ hr.congty.vn
# (tên miền phải trỏ về máy chủ này, và mở cổng 80 + 443 để Caddy xin chứng chỉ HTTPS)
SITE_ADDRESS=

# Tùy chọn
# HTTP_PORT=80
# HTTPS_PORT=443
# POSTGRES_DB=hr_agent
# POSTGRES_USER=hr_agent
# COMPANY_TIMEZONE=Asia/Ho_Chi_Minh
# THROTTLE_LOGIN_PER_MIN=5       # Giới hạn theo IP; nhiều người dùng chung một IP (văn phòng) thì tăng lên
# THROTTLE_CHAT_PER_MIN=20
# THROTTLE_GLOBAL_PER_MIN=120
# LLM_PROVIDER=  LLM_MODEL=  LLM_FALLBACK_MODELS=  LLM_TIMEOUT_S=
